# Core
NODE_ENV=development
LOG_LEVEL=info
SENTRY_DSN=
PLAUSIBLE_DOMAIN=

# API
API_HOST=0.0.0.0
API_PORT=4000
API_BASE_URL=http://localhost:4000
DEMO_MODE=false
DEMO_USER_ID=user_demo
INTERNAL_API_SECRET=replace-with-a-long-random-internal-secret

# Web/Auth
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/project_name?schema=public

# Redis / jobs
REDIS_URL=redis://localhost:6379
DELIVERY_CHANNEL=auto

# Email
RESEND_API_KEY=
EMAIL_FROM=aprendizaje@example.com

# Telegram
TELEGRAM_BOT_TOKEN=
